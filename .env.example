# Template only. NEVER put real credentials in this file.
# Copy to .env, fill in locally, and keep .env out of version control.
# Any secret committed here must be treated as compromised and rotated.
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
JWT_SECRET=replace-with-a-long-random-string
JWT_ISSUER=signfix-api
JWT_AUDIENCE=signfix-web
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
DB_POOL_SIZE=10
CORS_ORIGIN=http://localhost:5173,https://your-domain.example
VITE_API_URL=

# Firebase Cloud Messaging (web client)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Firebase Admin service account (server-only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

APP_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# AI platform (server-only)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_IMAGE_MODEL=gpt-image-2
REDIS_URL=redis://localhost:6379

# Cloudinary (server-only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AI_WORKER_ENABLED=false

# Optional notification providers
RESEND_API_KEY=
EMAIL_FROM=SignFix <notifications@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMTP for transactional email (registration / password-reset OTPs, order AWB emails)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TIMEOUT_MS=10000

# Service-area validation and Meta WhatsApp Cloud API
SERVICE_AREA_TOKEN_MINUTES=30
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_OTP_TEMPLATE_NAME=authentication_code_copy_code_button
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_OTP_TEMPLATE_HAS_BUTTON=true

# Payments
PAYMENT_GATEWAY_ENABLED=true
PAYMENT_GATEWAY_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_AUTO_CAPTURE=true
CUSTOMER_CAN_SELECT_SERVICE_PRIORITY=false

# Optional: allow all locations while service areas are not configured.
# Keep this false in production after adding active service areas in Admin > Service areas.
SERVICE_AREA_ALLOW_EMPTY=false

# Performance / fail-fast timeouts
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=8000
DB_QUERY_TIMEOUT_MS=10000
WHATSAPP_TIMEOUT_MS=7000
SERVICE_AREA_ALLOW_EMPTY=false

# Delhivery shipment tracking + auto AWB creation (server-only)
DELHIVERY_API_TOKEN=
DELHIVERY_BASE_URL=https://track.delhivery.com
DELHIVERY_TRACKING_CACHE_MINUTES=15
DELHIVERY_TIMEOUT_MS=10000
# Shipment creation (POST /api/cmu/create.json). Required for auto AWB on order creation.
DELHIVERY_PICKUP_LOCATION=
DELHIVERY_SHIPPING_MODE=SURFACE
DELHIVERY_DEFAULT_WEIGHT_GM=500
DELHIVERY_AUTO_CREATE_SHIPMENT=true

# Delhivery One MCP gateway (server-only). Powers /api/delhivery-one/*.
# Copy values from the Delhivery One dashboard MCP configuration. Never commit real secrets.
D1_CLIENT_ID=
D1_CLIENT_SECRET=
D1_AUTH_URL=
D1_REALM=
D1_CLIENT_CMS=
D1_MCP_URL=
D1_TIMEOUT_MS=15000
