{
  "name": "signfix",
  "private": true,
  "version": "1.0.0",
  "main": "app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server/dev.js",
    "dev:frontend": "vite --config vite.config.mjs",
